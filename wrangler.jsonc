{
  // Kleepee V1 — Cloudflare Worker + Durable Objects signaling server
  "name": "kleepee-v1",
  "main": "worker/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Object bindings
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDurableObject"
      }
    ]
  },

  // Durable Object migrations
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDurableObject"]
    }
  ],

  // Production environment
  "env": {
    "production": {
      "name": "kleepee-v1-production",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "SESSION_DO",
            "class_name": "SessionDurableObject"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["SessionDurableObject"]
        }
      ],
      "routes": [
        {
          "pattern": "kleepee-worker.adelekecode.dev/*",
          "zone_name": "adelekecode.dev"
        }
      ]
    }
  }
}
